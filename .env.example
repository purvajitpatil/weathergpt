# ═══════════════════════════════════════════════════════════════════════════════
# WeatherGPT — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy to .env and fill in real values.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ─── Demo / Live Mode ────────────────────────────────────────────────────────
# on   = always use deterministic fixture data (dev/demo)
# off  = live providers only; fails if unavailable
# auto = try live, fall back to clearly-labeled demo if unreachable
WEATHERGPT_DEMO_MODE=auto

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
DATABASE_URL=postgresql://weathergpt:weathergpt@localhost:5432/weathergpt

# ─── Cache (Redis) ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── LLM (Gemini) ────────────────────────────────────────────────────────────
# Required for AI explanation features. Without this, the system operates in
# deterministic mode (real data, no LLM narration).
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ─── ML Inference Service ────────────────────────────────────────────────────
ML_INFERENCE_URL=http://localhost:8001
ML_MODEL_VERSION=xgb-rain-v1.2
# Optional API key for ML service authentication in production
ML_API_KEY=

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Leave empty for same-origin only.
CORS_ORIGINS=

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# ─── Cache TTLs (seconds) ────────────────────────────────────────────────────
CACHE_TTL_CURRENT_S=300      # 5 min for current weather
CACHE_TTL_FORECAST_S=900     # 15 min for forecast
CACHE_TTL_AQI_S=1800         # 30 min for air quality
CACHE_TTL_GEO_S=86400        # 24h for geocoding
CACHE_TTL_ALERTS_S=300       # 5 min for alerts

# ─── Timeouts ────────────────────────────────────────────────────────────────
REQUEST_TIMEOUT_MS=20000
LLM_TIMEOUT_MS=30000

# ─── Worker (Background Alert Ingestion) ──────────────────────────────────────
WORKER_INGEST_INTERVAL_MS=300000  # 5 minutes
